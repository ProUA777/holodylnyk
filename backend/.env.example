# AI провайдер: "anthropic" для продакшну або "mock" (тестові відповіді без ключа)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Ключі застосунків через кому. Для релізу придумай довгий випадковий ключ
# і передай той самий у збірку: --dart-define=APP_KEY=...
APP_KEYS=dev-key-food,dev-key-bricks

# Безкоштовних сканувань на один пристрій за добу
DAILY_LIMIT=20
MAX_IMAGE_MB=8
DB_PATH=data/limits.db
LOG_LEVEL=INFO

# Домен для HTTPS (docker-compose + Caddy), напр. api.whattobuild.app
DOMAIN=
