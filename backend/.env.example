# ===== AI =====
# mock = тестові відповіді без ключа (щоб будувати апку). anthropic = справжній AI.
PHOTOAI_AI_PROVIDER=mock
# Ключ з https://console.anthropic.com → API Keys (починається з sk-ant-)
PHOTOAI_ANTHROPIC_API_KEY=

# Модель на кожен крок
PHOTOAI_MODEL_ANALYZE=claude-haiku-5-5
PHOTOAI_MODEL_REFINE=claude-haiku-5-5
PHOTOAI_MODEL_DETAIL=claude-sonnet-5-5

# ===== Доступ =====
# Ключ апки (вигадай довгий випадковий; той самий вписується в збірку апки як API_KEY).
# Згенерувати: python -c "import secrets;print(secrets.token_urlsafe(32))"
PHOTOAI_API_KEYS=

# ===== Ліміти на один телефон за добу (0 = без ліміту) =====
PHOTOAI_DAILY_PHOTO_LIMIT=10
PHOTOAI_DAILY_REFINE_LIMIT=40
PHOTOAI_DAILY_DETAIL_LIMIT=30
PHOTOAI_RATE_LIMIT_PER_MINUTE=10

PHOTOAI_MAX_UPLOAD_MB=10
PHOTOAI_MAX_PHOTOS=3
PHOTOAI_DB_PATH=data/photoai.sqlite3

# Для політики конфіденційності https://api.твійдомен.com/privacy (вказується в Google Play)
PHOTOAI_CONTACT_EMAIL=твій@email.com
